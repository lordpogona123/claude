      "parameters": {
        "functionCode": "const investor = $json;\nreturn [{\n  json: {\n    fullName: investor.fullName || investor.name || '',\n    companyName: investor.companyName || investor.fund || '',\n    role: investor.role || investor.title || '',\n    linkedinUrl: investor.linkedinUrl || '',\n    website: investor.website || '',\n    email: investor.email || '',\n    location: investor.location || investor.city || investor.country || '',\n    rawLinkedIn: investor.linkedinContent || '',\n    rawWebsite: investor.websiteContent || '',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
