    {
      "parameters": {
        "model": "gpt-4o-mini",
        "prompt": "You are an expert VC analyst. Given this raw data about an investor, summarize who they are, what they care about, what they usually invest in, and which topics related to AI automation and productivity might resonate with them. Return ONLY valid JSON with the keys: personaSummary, investmentThesis, topicsToMention, possibleObjections. Input data:\n{{JSON.stringify($json)}}",
        "temperature": 0.2,
        "maxTokens": 600
      },
      "name": "Summarize Investor Profile (AI)",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        640,
        0
      ],
      "id": "Summarize Investor Profile (AI)",
      "credentials": {
        "openAiApi": {
          "id": "openai-cred-id",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "const summary = $json;\nconst investor = $items('Aggregate Investor Data', 0, 0).json;\nconst companyInfo = `You represent Singularity Labs, an AI automation agency from Valencia, Spain that builds automations and AI agents using n8n, Zapier, Notion, LinkedIn and custom LLMs to help B2B companies get more leads, save time, and scale operations.`;\nreturn [{ json: { ...investor, investorSummary: summary, companyInfo } }];"
      },
      "name": "Prepare Outreach Context",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        840,
        0
      ],
      "id": "Prepare Outreach Context"
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "prompt": "You are writing a highly personalized outreach message to an investor. You represent Singularity Labs, an AI automation agency from Valencia that builds automations and AI agents using tools like n8n, Zapier, Notion, LinkedIn and LLMs to help B2B companies get more leads and save time.\n\nUse the JSON below describing the investor to:\n1) Connect with their background and investment thesis.\n2) Mention 1–2 very specific details about them (company, sector, geography, portfolio, or topics they talk about).\n3) Explain, in simple and concrete terms, how Singularity Labs could help their portfolio or their own dealflow.\n4) End with a clear CTA for a short call (15–20 minutes).\n\nConstraints:\n- Tone: professional but friendly, concise, no fluff.\n- Length: max 160–200 words.\n- Output MUST be valid JSON with two keys: subject, body.\n\nInvestor JSON:\n{{JSON.stringify($json)}}",
        "temperature": 0.25,
        "maxTokens": 700
      },
      "name": "Generate Personalized Outreach Message (AI)",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        1040,
        0
      ],
      "id": "Generate Personalized Outreach Message (AI)",
      "credentials": {
        "openAiApi": {
          "id": "openai-cred-id",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "const message = $json;\nconst investor = $items('Prepare Outreach Context', 0, 0).json;\nreturn [{ json: { ...investor, ...message } }];"
      },
      "name": "Attach Message to Investor",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1240,
        0
      ],
      "id": "Attach Message to Investor"
    },
